rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is authenticated
    function isAuth() {
      return request.auth != null && request.auth.uid != null;
    }

    match /users/{userId} {
      // Users can read their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users can write their own data, but CANNOT modify sensitive fields like balances, xp, or roles
      allow write: if request.auth != null && request.auth.uid == userId
                   && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['doge_balance', 'staked_balance', 'ads_balance', 'xp', 'role', 'last_claim_time', 'total_claims', 'faucet_claims', 'stake_timestamp', 'pet_birth_date', 'pet_hunger', 'pet_happiness', 'pet_energy', 'pet_last_interaction', 'pet_total_distance_walked']);
    }
    
    // Updates/News collection: Anyone can read, only admin can write (assuming admin backend uses firebase-admin which bypasses rules)
    match /updates/{updateId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'P8iffVqbUgetAVA4MdHVZ1CfvUv1';
    }

    // Dynamic Content Collections (Ads, Partners, Sponsors, Placeholders)
    match /chat_messages/{messageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /ptc_ads/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'P8iffVqbUgetAVA4MdHVZ1CfvUv1';
    }
    match /partners/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'P8iffVqbUgetAVA4MdHVZ1CfvUv1';
    }
    match /bonus_sponsors/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'P8iffVqbUgetAVA4MdHVZ1CfvUv1';
    }
    match /sponsor_placeholders/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'P8iffVqbUgetAVA4MdHVZ1CfvUv1';
    }
    
    // Blog Posts Collection
    match /blog_posts/{postId} {
      allow read: if true; // Anyone can read the blog
      allow write: if false; // Only the Python script (Firebase Admin) can write
    }

    // Default rule: block all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
