rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is authenticated
    function isAuth() {
      return request.auth != null && request.auth.uid != null;
    }

    function userSafeProfileFields() {
      return [
        'email',
        'display_name',
        'photo_url',
        'fcm_token',
        'notifications_enabled',
        'profile_setup_skipped',
        'setupComplete',
        'joined_date'
      ];
    }

    function validProfileFields(data, changed) {
      return (!changed.hasAny(['email']) || data.get('email', null) == null || (data.email is string && data.email.size() <= 320))
        && (!changed.hasAny(['display_name']) || data.get('display_name', null) == null || (data.display_name is string && data.display_name.size() <= 100))
        && (!changed.hasAny(['photo_url']) || data.get('photo_url', null) == null || (data.photo_url is string && data.photo_url.size() <= 2048))
        && (!changed.hasAny(['fcm_token']) || data.get('fcm_token', null) == null || (data.fcm_token is string && data.fcm_token.size() <= 4096))
        && (!changed.hasAny(['joined_date']) || data.get('joined_date', null) == null || (data.joined_date is string && data.joined_date.size() <= 40))
        && (!changed.hasAny(['notifications_enabled']) || data.get('notifications_enabled', false) is bool)
        && (!changed.hasAny(['profile_setup_skipped']) || data.get('profile_setup_skipped', false) is bool)
        && (!changed.hasAny(['setupComplete']) || data.get('setupComplete', false) is bool);
    }

    match /users/{userId} {
      // Users can read their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users may only create a lightweight profile shell. Reward, balance,
      // role, and pet fields are server-owned and must not be client-created.
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(userSafeProfileFields())
                    && validProfileFields(request.resource.data, request.resource.data.keys());
      
      // New server-owned fields are protected by default. Preserve the existing
      // admin-only pet unlock action without allowing clients to change roles.
      allow update: if request.auth != null && request.auth.uid == userId
                   && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(userSafeProfileFields())
                         && validProfileFields(request.resource.data, request.resource.data.diff(resource.data).affectedKeys()))
                       || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['pet_owned_accessories', 'pet_owned_tricks', 'active_trick_buffs'])));
      allow delete: if false;
    }
    
    // Helper function to check if a user is an admin
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Updates/News collection: Anyone can read, only admin can write (assuming admin backend uses firebase-admin which bypasses rules)
    match /updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dynamic Content Collections (Ads, Partners, Sponsors, Placeholders)
    match /chat_messages/{messageId} {
      allow read: if true;
      allow write: if false; // Chat mutations use the authenticated, moderated backend.
    }
    match /ptc_ads/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /partners/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bonus_sponsors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sponsor_placeholders/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Blog Posts Collection
    match /blog_posts/{postId} {
      allow read: if true; // Anyone can read the blog
      allow write: if false; // Only the Python script (Firebase Admin) can write
    }

    // Reward Audits Collection
    match /reward_audits/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Only backend writes here
    }

    // Default rule: block all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
