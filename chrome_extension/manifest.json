{
  "manifest_version": 3,
  "name": "Golden Paw: Pet & Faucet",
  "short_name": "Golden Paw",
  "version": "1.0.0",
  "description": "Look after your Golden Paw Shiba and claim the 5-minute Dogecoin faucet from your toolbar.",
  "homepage_url": "https://goldenpaw.dog/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Golden Paw",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "identity"],
  "host_permissions": [
    "https://golden-paw-vault.onrender.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ]
}
