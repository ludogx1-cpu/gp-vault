{
  "dataconnect": {
    "source": "dataconnect"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "golden-paw-database",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "downloads/**",
      "*.exe"
    ],
    "headers": [
      {
        "source": "captcha.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "dI2bMysU0VopkjiwI24s91JqGMpl_knGpXg32s0Z.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "golden-paw.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=golden-paw.apk"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/captcha.html",
        "destination": "/captcha.html"
      },
      {
        "source": "/sponsors.html",
        "destination": "/sponsors.html"
      },
      {
        "source": "/partners.html",
        "destination": "/partners.html"
      },
      {
        "source": "/thankyou.html",
        "destination": "/thankyou.html"
      },
      {
        "source": "/adsterra_728x90.html",
        "destination": "/adsterra_728x90.html"
      },
      {
        "source": "/adsterra_468x60.html",
        "destination": "/adsterra_468x60.html"
      },
      {
        "source": "/adsterra_300x250.html",
        "destination": "/adsterra_300x250.html"
      },
      {
        "source": "/adsterra_160x600.html",
        "destination": "/adsterra_160x600.html"
      },
      {
        "source": "/adsterra_160x300.html",
        "destination": "/adsterra_160x300.html"
      },
      {
        "source": "/adsense_ptc_1.html",
        "destination": "/adsense_ptc_1.html"
      },
      {
        "source": "/adsense_ptc_2.html",
        "destination": "/adsense_ptc_2.html"
      },
      {
        "source": "/ad.html",
        "destination": "/ad.html"
      },
      {
        "source": "/about.html",
        "destination": "/about.html"
      },
      {
        "source": "/golden-paw.apk",
        "destination": "/golden-paw.apk"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
